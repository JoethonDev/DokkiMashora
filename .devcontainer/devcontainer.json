{
  "name": "DokkiMashora 10-day trial",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu24.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": false
    }
  },
  "forwardPorts": [
    80
  ],
  "portsAttributes": {
    "80": {
      "label": "DokkiMashora Django demo",
      "onAutoForward": "notify"
    }
  },
  "postStartCommand": "bash .devcontainer/start-demo.sh"
}
