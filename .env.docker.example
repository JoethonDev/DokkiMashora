# Copy to .env.docker. Never commit the real file.
POSTGRES_DB=dokkimashora
POSTGRES_USER=dokkimashora
# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-url-safe-random-value

DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_DEBUG=false
# Generate with: openssl rand -hex 64
DJANGO_SECRET_KEY=replace-with-a-long-random-value
# Django ALLOWED_HOSTS uses a leading dot for wildcard subdomains.
DJANGO_ALLOWED_HOSTS=example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com
DJANGO_SECURE_SSL_REDIRECT=true
SITE_URL=https://example.com

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
# Seconds before an SMTP connection/operation is aborted (worker-side).
EMAIL_TIMEOUT=20
DEFAULT_FROM_EMAIL=no-reply@example.com

# R2 is required for protected production uploads.
# Replace every value below with your own before use. Never commit real
# credentials; treat any value that was ever committed as compromised.
USE_R2_STORAGE=<true-or-false>
R2_ACCESS_KEY_ID=<your-r2-access-key-id>
R2_SECRET_ACCESS_KEY=<your-r2-secret-access-key>
R2_BUCKET_NAME=<your-r2-bucket-name>
R2_ENDPOINT_URL=<your-r2-endpoint-url>
R2_PUBLIC_BASE_URL=<optional-public-base-url>
R2_REGION=auto
R2_ACCOUNT_ID=<your-r2-account-id>

DJANGO_SEED_DEMO=false
DJANGO_SUPERUSER_USERNAME=admin@example.com
DJANGO_SUPERUSER_PASSWORD=<choose-a-strong-superuser-password>
