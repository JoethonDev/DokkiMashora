# Copy to .env.docker. Never commit the real file.
POSTGRES_DB=dokkimashora
POSTGRES_USER=dokkimashora
# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-url-safe-random-value

DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_DEBUG=false
# Generate with: openssl rand -hex 64
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_ALLOWED_HOSTS=example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com
DJANGO_SECURE_SSL_REDIRECT=true
SITE_URL=https://example.com

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=no-reply@example.com

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT_SECONDS=30

# R2 is required for protected production uploads.
USE_R2_STORAGE=false
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_PUBLIC_BASE_URL=
R2_REGION=auto
R2_ACCOUNT_ID=

DJANGO_SEED_DEMO=false
DJANGO_SUPERUSER_USERNAME=admin@example.com
DJANGO_SUPERUSER_PASSWORD=replace-before-first-use
