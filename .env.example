# --- Django ----------------------------------------------------------------
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=django-insecure-change-me-in-production
# Django ALLOWED_HOSTS uses a leading dot for wildcard subdomains.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.ngrok-free.app
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://*.ngrok-free.app

# Set DJANGO_SETTINGS_MODULE to dev, prod, or test.
DJANGO_SETTINGS_MODULE=config.settings.dev

# --- Database --------------------------------------------------------------
# Example PostgreSQL URL: postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=sqlite:///db.sqlite3

# --- Email (SMTP) ----------------------------------------------------------
# Production must use an SMTP provider. Local dev can leave EMAIL_BACKEND unset.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
# Seconds before an SMTP connection/operation is aborted (worker-side).
EMAIL_TIMEOUT=20
DEFAULT_FROM_EMAIL=no-reply@dokkimashora.local

# --- Cloudflare R2 (S3-compatible) -----------------------------------------
USE_R2_STORAGE=false
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
R2_PUBLIC_BASE_URL=
R2_REGION=auto
R2_ACCOUNT_ID=
# Storage settings (local vs R2)
STORAGE_BACKEND=local
HOMEWORK_MAX_UPLOAD_MB=25
AUDIO_MAX_UPLOAD_MB=50

# --- Demo / superuser -----------------------------------------------------
# Set to false to skip demo users during seed.
DJANGO_SEED_DEMO=true
# Used by the standard `python manage.py createsuperuser --noinput` command.
DJANGO_SUPERUSER_USERNAME=admin@dokkimashora.test
DJANGO_SUPERUSER_PASSWORD=ChangeMe123!
